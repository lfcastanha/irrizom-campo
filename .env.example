# Copie para .env.local (no seu computador) e cadastre as mesmas variáveis na Vercel.
# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a "publishable key" (sb_publishable_...) ou a antiga "anon key". NUNCA a service_role/secret.
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
